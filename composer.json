{
    "name": "emisor/h1-poc",
    "description": "POC local ficticia de compatibilidad; sin transporte fiscal ni módulos comerciales",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.3.36",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_pgsql": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "greenter/xml": "^5.3",
        "greenter/xmldsig": "^5.1",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": "@php artisan poc:invoice"
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
